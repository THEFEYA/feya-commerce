# Supabase public read-only client
# Get these from Supabase Project Settings → API.
# Do not commit .env.local with real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred public key for SSR auth; legacy anon key remains a temporary fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never expose service role keys in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only internal health/check variables. Do not prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional small model override for /api/internal/seo-keyword-cleanup.
OPENAI_SEO_CLEANUP_MODEL=
# Optional independent Content Quality Auditor model override.
OPENAI_CQA_MODEL=
# Optional Growth OS SEO Content Optimizer shadow model override.
OPENAI_SCO_MODEL=
# Optional independent OSPM keyword-cleanup review model override.
OPENAI_KEYWORD_REVIEW_MODEL=
# Optional OSPM semantic query-cluster proposal model override.
OPENAI_QUERY_CLUSTER_MODEL=
# Optional OSPM primary page-ownership proposal model override.
OPENAI_PAGE_OWNERSHIP_MODEL=
FEYA_INTERNAL_API_TOKEN=

# Google Ads API — server-only OAuth / Cloud project access.
# Since 2026-09-09 API access level is associated with the Google Cloud project
# that owns these OAuth credentials. Developer tokens are sunset and are not sent
# by the FEYA runtime.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_GEO_TARGET_CONSTANTS=
GOOGLE_ADS_LANGUAGE_CONSTANT=languageConstants/1000
GOOGLE_ADS_KEYWORD_PLAN_NETWORK=GOOGLE_SEARCH

# FEYA Admin auth gate — server-only configuration.
# Keep false until an approved admin allowlist is configured.
FEYA_ADMIN_AUTH_REQUIRED=false
FEYA_ADMIN_ALLOWED_USER_IDS=
FEYA_ADMIN_ALLOWED_EMAILS=

# Public search launch controls.
# Keep false until Launch Readiness PASS. Individual PDPs also require
# SEO Portfolio indexation_intent=indexable before they become indexable.
NEXT_PUBLIC_SITE_URL=https://zofeya.com
FEYA_SEARCH_INDEXING_ENABLED=false
FEYA_STRUCTURED_DATA_ENABLED=false

# Search foundation: explicit custom origin confirmation is required.
# Preview/local deployments remain noindex even with the main switch enabled.
FEYA_CANONICAL_ORIGIN_CONFIRMED=false
