# FEYA Commerce environment example
# Copy to .env.local for local development.
# Never commit real secrets.

# Supabase public read-only client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only service client
# Never expose this value in client components or NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used for redirects, canonical URLs, callbacks and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal admin/API protection
FEYA_INTERNAL_API_TOKEN=
FEYA_ADMIN_ACCESS_TOKEN=

# OpenAI server-only SEO generation
# Do not create NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY=
FEYA_SEO_OPENAI_MODEL=gpt-5.4-mini
FEYA_SEO_AI_GENERATION_ENABLED=false
FEYA_SEO_DRAFT_STORAGE_ENABLED=false

# Google Ads keyword metrics
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Future secure payment provider settings
# Do not activate real payment until provider choice, webhook and order-finalization flow are approved.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Operational emails
FEYA_ORDER_NOTIFICATION_EMAIL=
FEYA_SUPPORT_EMAIL=
