# Supabase public read-only client
# Get these from Supabase Project Settings → API.
# Do not commit .env.local with real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred public key for SSR auth; legacy anon key remains a temporary fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never expose service role keys in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only internal health/check variables. Do not prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional small model override for /api/internal/seo-keyword-cleanup.
OPENAI_SEO_CLEANUP_MODEL=
# Optional independent Content Quality Auditor model override.
OPENAI_CQA_MODEL=
# Optional Growth OS SEO Content Optimizer shadow model override.
OPENAI_SCO_MODEL=
# Optional independent OSPM keyword-cleanup review model override.
OPENAI_KEYWORD_REVIEW_MODEL=
# Optional OSPM semantic query-cluster proposal model override.
OPENAI_QUERY_CLUSTER_MODEL=
# Optional OSPM primary page-ownership proposal model override.
OPENAI_PAGE_OWNERSHIP_MODEL=
FEYA_INTERNAL_API_TOKEN=

# Google Ads API — server-only OAuth / Cloud project access.
# Since 2026-09-09 API access level is associated with the Google Cloud project
# that owns these OAuth credentials. Developer tokens are sunset and are not sent
# by the FEYA runtime.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_GEO_TARGET_CONSTANTS=
GOOGLE_ADS_LANGUAGE_CONSTANT=languageConstants/1000
GOOGLE_ADS_KEYWORD_PLAN_NETWORK=GOOGLE_SEARCH

# FEYA Admin auth gate — server-only configuration.
# Keep false until an approved admin allowlist is configured.
FEYA_ADMIN_AUTH_REQUIRED=false
FEYA_ADMIN_ALLOWED_USER_IDS=
FEYA_ADMIN_ALLOWED_EMAILS=

# Optional step-up authentication for protected owner mutations while the read-only admin preview remains open.
# Keep false until an allowlisted Supabase Auth owner can sign in. This does not make the whole admin require login.
FEYA_OWNER_ACTION_AUTH_REQUIRED=false
FEYA_OWNER_ACTIONS_ENABLED=false
# Separate owner-only draft workspace. Does not enable general owner actions, live rates or payment.
# Requires the same verified Supabase Auth owner allowlist and protected authentication.
FEYA_DELIVERY_WORKSPACE_DRAFT_ENABLED=false
# Independent approval of an exact saved version after business review.
# Approval stays private; this does not publish cart rates or enable order/payment.
FEYA_DELIVERY_WORKSPACE_APPROVAL_ENABLED=false
FEYA_COMMERCE_PRICE_BASELINE_ADOPTION_ENABLED=false
FEYA_COMMERCE_MANUAL_CONFIGURATION_REPAIR_ENABLED=false
FEYA_COMMERCE_MANUAL_PRICE_GOVERNANCE_ENABLED=false

# Public search launch controls.
# Keep false until Launch Readiness PASS. Individual PDPs also require
# SEO Portfolio indexation_intent=indexable before they become indexable.
NEXT_PUBLIC_SITE_URL=https://thefeya.com/
FEYA_SEARCH_INDEXING_ENABLED=false
FEYA_STRUCTURED_DATA_ENABLED=false

# Search foundation: explicit custom origin confirmation is required.
# Preview/local deployments remain noindex even with the main switch enabled.
FEYA_CANONICAL_ORIGIN_CONFIRMED=false

# Dormant metric storage. Legacy consumer reconciliation and Auth E2E are also required.
FEYA_METRIC_IMPORT_STORAGE_ENABLED=false


# Closed catalog review only; preview/development + authenticated owner required.
# No public launch/index/checkout grant.
FEYA_CLOSED_REVIEW_RELEASE=off


# Public legal/privacy identity. Do not populate with an inactive former business merely to unblock a page.
# These fields disclose the confirmed site operator's postal identity.
# They do not confirm that the operator is also the privacy controller or transaction seller.
FEYA_PUBLIC_LEGAL_IDENTITY_CONFIRMED=false
FEYA_PUBLIC_LEGAL_NAME=
FEYA_PUBLIC_LEGAL_ADDRESS_LINE1=
FEYA_PUBLIC_LEGAL_ADDRESS_LINE2=
FEYA_PUBLIC_LEGAL_ADDRESS_CITY=
FEYA_PUBLIC_LEGAL_ADDRESS_REGION=
FEYA_PUBLIC_LEGAL_ADDRESS_POSTAL_CODE=
FEYA_PUBLIC_LEGAL_ADDRESS_COUNTRY=

# Separate public privacy-controller disclosure. A real person or legal entity must be confirmed.
# Do not infer this role from Seller Online, a showroom, the storefront brand or a suspended business.
# This is not a blanket exemption from applicable postal-address / representative obligations.
FEYA_PRIVACY_CONTROLLER_CONFIRMED=false
FEYA_PRIVACY_CONTROLLER_NAME=
FEYA_PRIVACY_CONTROLLER_CONTACT_EMAIL=

# Optional production analytics. Keep false until privacy-controller identity,
# consent behavior and the correct production GA4 web stream are verified.
FEYA_ANALYTICS_ENABLED=false
FEYA_ANALYTICS_PRIVACY_READY=false
FEYA_GA4_MEASUREMENT_ID=

# Seller Online commerce activation. Both switches are required before the
# provider is presented publicly as an active transaction/payment party.
FEYA_SELLER_ONLINE_PAYMENTS_ENABLED=false
FEYA_SELLER_ONLINE_ROLE_CONFIRMED=false


# M2 quote-bound order-intent writer. This accepts quote receipt IDs only;
# browser prices/totals are never order authority. Keep false until the migration
# is installed and exact runtime checks pass. It still cannot create an order/payment.
FEYA_COMMERCE_ORDER_INTENT_ENABLED=false


# M2 server-owned shipping quote writer. The client never supplies shipping amount.
# Keep false until exact approved EUR rates (or a verified provider quote adapter) exist.
FEYA_COMMERCE_SHIPPING_QUOTE_ENABLED=false

# M2 approved destination-aware shipping receipt v2: private, internal, and non-payable.
# Requires reviewed exact owner-approved EUR rate profile and installed v2 schema.
# No public quote API route or provider session is shipped with this flag.
FEYA_COMMERCE_APPROVED_SHIPPING_QUOTE_V2_ENABLED=false

# M2 carrier-probe adapter from Ukrposhta international 2026 API. DEFAULT OFF.
# Both secrets require contractual credentials from Ukrposhta; keep them in
# Vercel Secret settings, never in repository, .env.example values, logs or chat.
# No public quote API route ships with this switch.
FEYA_UKRPOSHTA_AVAILABILITY_ENABLED=false
# Separate service-only immutable observation writer: no public API or rates.
# Do not enable until real provider keys AND protected owner-reviewed
# product+transport->Standard/Express+parcel mapping are independently proven.
FEYA_UKRPOSHTA_EVIDENCE_CAPTURE_ENABLED=false
# Private owner-review-only shipping-v2 parcel/source coverage, NOT public
# availability, confirmed postal routes, rates, order or payment.
FEYA_COMMERCE_CARRIER_COVERAGE_REVIEW_ENABLED=false
# Owner-only measured parcel envelope review: requires existing approved delivery
# profile and an authenticated allowlisted owner; independent of any paid route.
# Keep OFF until exact carrier owner review CI, RLS and admin access are verified.
FEYA_COMMERCE_CARRIER_OWNER_REVIEW_ENABLED=false
# Phase13: ORIGINAL human-approved 207 PDP SEO copy, separately governed.
# OFF until whole 207 exact SHA/pin audit, owner approval, origin crawl, ready CI
# and explicit production publication. No auto indexation, no payment.
# Only the exact pair below enables read-only description/metadata projection.
FEYA_PUBLIC_APPROVED_PDP_COPY_RELEASE=off
FEYA_PUBLIC_APPROVED_PDP_OWNER_SIGNOFF=off

FEYA_UKRPOSHTA_AUTH_BEARER=
FEYA_UKRPOSHTA_USER_TOKEN=


# Internal cart item + shipping + €5 additional DISTINCT listing breakdown.
# Review only; tax/provider fees remain UNKNOWN, never publish a payable total.
FEYA_COMMERCE_CART_COST_REVIEW_ENABLED=false

# M2 private, immutable address + shipping v2 + current policy + exact pre-tax amount.\n# NEVER enable until verified privacy controller and retention/transaction policy.\n# No public route, no tax/discount assumption and no payment/provider session.\nFEYA_COMMERCE_CHECKOUT_PREFLIGHT_V2_ENABLED=false\n\n# M2 immutable checkout total snapshot. Requires server merchandise intent +
# server shipping quote. Still cannot create orders or provider payment sessions.
FEYA_COMMERCE_CHECKOUT_SNAPSHOT_ENABLED=false
