      ],
      "identity": "feya_commerce_apply_seo_keyword_metric_import_v1(text,text)",
      "definition": "CREATE OR REPLACE FUNCTION public.feya_commerce_apply_seo_keyword_metric_import_v1(p_batch_code text, p_source_file_name text DEFAULT NULL::text)\n RETURNS TABLE(inserted_snapshots integer)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\ndeclare\n  v_inserted integer;\nbegin\n  insert into public.feya_commerce_seo_keyword_metric_snapshots_v1 (\n    keyword_norm,\n    source_api,\n    geo,\n    language,\n    avg_monthly_searches,\n    competition,\n    competition_index,\n    low_top_of_page_bid,\n    high_top_of_page_bid,\n    monthly_search_volumes_json,\n    fetched_at,\n    raw_payload_json,\n    data_freshness_status\n  )\n  select\n    r.keyword_norm,\n    'manual_keyword_metrics_import' as source_api,\n    r.geo,\n    r.language,\n    r.avg_monthly_searches,\n    r.competition,\n    r.competition_index,\n    r.low_top_of_page_bid,\n    r.high_top_of_page_bid,\n    case\n      when nullif(btrim(r.monthly_search_volumes_raw), '') is null then null::jsonb\n      when btrim(r.monthly_search_volumes_raw) ~ '^\\s*[\\[{]' then r.monthly_search_volumes_raw::jsonb\n      else jsonb_build_object('raw', r.monthly_search_volumes_raw)\n    end as monthly_search_volumes_json,\n    now() as fetched_at,\n    jsonb_build_object(\n      'batch_code', r.batch_code,\n      'keyword', r.keyword,\n      'keyword_norm', r.keyword_norm,\n      'source_file_name', r.source_file_name,\n      'imported_at', r.imported_at,\n      'import_status', r.import_status,\n      'import_note', r.import_note,\n      'bridge', 'manual_validation_export_import_v1'\n    ) as raw_payload_json,\n    'fresh_manual_import' as data_freshness_status\n  from public.feya_commerce_v_seo_keyword_metric_import_ready_v1 r\n  where r.batch_code = p_batch_code\n    and (p_source_file_name is null or r.source_file_name = p_source_file_name);\n\n  get diagnostics v_inserted = row_count;\n  return query select v_inserted;\nend;\n$function$\n",
      "anon_execute": false,
      "auth_execute": false,
      "security_definer": true
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "owner": "postgres",
      "options": null,
      "identity": "feya_commerce_fn_promote_keyword_metric_import_v1(text)",
      "definition": "CREATE OR REPLACE FUNCTION public.feya_commerce_fn_promote_keyword_metric_import_v1(p_batch_code text)\n RETURNS TABLE(batch_code text, normalized_rows integer, inserted_snapshots integer, updated_staging_rows integer, skipped_rows integer)\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\ndeclare\n  v_normalized integer := 0;\n  v_inserted integer := 0;\n  v_updated integer := 0;\n  v_skipped integer := 0;\nbegin\n  update public.feya_commerce_seo_keyword_metric_import_staging_v1 s\n  set keyword_norm = lower(trim(s.keyword)),\n      import_status = coalesce(nullif(s.import_status, ''), 'pending')\n  where s.batch_code = p_batch_code\n    and (s.keyword_norm is null or btrim(s.keyword_norm) = '')\n    and s.keyword is not null;\n  get diagnostics v_normalized = row_count;\n\n  insert into public.feya_commerce_seo_keyword_metric_snapshots_v1 (\n    keyword_norm,\n    source_api,\n    geo,\n    language,\n    avg_monthly_searches,\n    competition,\n    competition_index,\n    low_top_of_page_bid,\n    high_top_of_page_bid,\n    monthly_search_volumes_json,\n    fetched_at,\n    raw_payload_json,\n    data_freshness_status\n  )\n  select\n    lower(trim(s.keyword_norm)) as keyword_norm,\n    'google_ads_csv'::text as source_api,\n    coalesce(nullif(s.geo, ''), 'US') as geo,\n    coalesce(nullif(s.language, ''), 'en') as language,\n    s.avg_monthly_searches,\n    nullif(s.competition, '') as competition,\n    s.competition_index,\n    s.low_top_of_page_bid,\n    s.high_top_of_page_bid,\n    case\n      when s.monthly_search_volumes_raw is not null and btrim(s.monthly_search_volumes_raw) <> ''\n        then jsonb_build_object('raw', s.monthly_search_volumes_raw)\n      else null::jsonb\n    end as monthly_search_volumes_json,\n    now() as fetched_at,\n    jsonb_build_object(\n      'batch_code', s.batch_code,\n      'source_file_name', s.source_file_name,\n      'import_row_id', s.import_row_id,\n      'imported_at', s.imported_at\n    ) as raw_payload_json,\n    'fresh_manual_import'::text as data_freshness_status\n  from public.feya_commerce_seo_keyword_metric_import_staging_v1 s\n  where s.batch_code = p_batch_code\n    and s.keyword_norm is not null\n    and btrim(s.keyword_norm) <> ''\n    and s.avg_monthly_searches is not null\n    and coalesce(s.import_status, 'pending') not in ('promoted_to_snapshots', 'error')\n    and not exists (\n      select 1\n      from public.feya_commerce_seo_keyword_metric_snapshots_v1 m\n      where m.keyword_norm = lower(trim(s.keyword_norm))\n        and m.geo = coalesce(nullif(s.geo, ''), 'US')\n        and m.language = coalesce(nullif(s.language, ''), 'en')\n        and m.source_api = 'google_ads_csv'\n        and m.raw_payload_json ->> 'batch_code' = s.batch_code\n    );\n  get diagnostics v_inserted = row_count;\n\n  update public.feya_commerce_seo_keyword_metric_import_staging_v1 s\n  set import_status = case\n        when s.keyword_norm is null or btrim(s.keyword_norm) = '' then 'error'\n        when s.avg_monthly_searches is null then 'error'\n        else 'promoted_to_snapshots'\n      end,\n      import_note = case\n        when s.keyword_norm is null or btrim(s.keyword_norm) = '' then 'Missing keyword_norm / keyword.'\n        when s.avg_monthly_searches is null then 'Missing avg_monthly_searches; row was not promoted.'\n        else 'Promoted to metric snapshots by feya_commerce_fn_promote_keyword_metric_import_v1.'\n      end\n  where s.batch_code = p_batch_code\n    and coalesce(s.import_status, 'pending') not in ('promoted_to_snapshots', 'error');\n  get diagnostics v_updated = row_count;\n\n  select count(*)::int\n  into v_skipped\n  from public.feya_commerce_seo_keyword_metric_import_staging_v1 s\n  where s.batch_code = p_batch_code\n    and s.import_status = 'error';\n\n  return query select p_batch_code, v_normalized, v_inserted, v_updated, v_skipped;\nend;\n$function$\n",
      "anon_execute": false,
      "auth_execute": false,
      "security_definer": true
    },
    {
      "acl": "{postgres=X/postgres,service_role=X/postgres}",
      "owner": "postgres",
      "options": null,
      "identity": "feya_fn_apply_manual_keyword_metrics_v1(text)",
      "definition": "CREATE OR REPLACE FUNCTION public.feya_fn_apply_manual_keyword_metrics_v1(p_batch_code text DEFAULT NULL::text)\n RETURNS TABLE(updated_rows integer, matched_candidates integer, batch_filter text)\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\ndeclare\n  v_updated integer := 0;\n  v_matched integer := 0;\nbegin\n  with latest_metric as (\n    select distinct on (s.keyword_norm)\n      s.keyword_norm,\n      s.batch_code,\n      s.geo,\n      s.language,\n      s.avg_monthly_searches,\n      s.competition,\n      s.competition_index,\n      s.low_top_of_page_bid,\n      s.high_top_of_page_bid,\n      s.imported_at\n    from public.feya_commerce_seo_keyword_metric_import_staging_v1 s\n    where s.keyword_norm is not null\n      and (p_batch_code is null or s.batch_code = p_batch_code)\n    order by s.keyword_norm, s.imported_at desc nulls last, s.import_row_id desc\n  )\n  select count(*)::int into v_matched\n  from public.feya_manual_keyword_candidate_v1 c\n  join latest_metric m on m.keyword_norm = c.keyword_norm;\n\n  with latest_metric as (\n    select distinct on (s.keyword_norm)\n      s.keyword_norm,\n      s.batch_code,\n      s.geo,\n      s.language,\n      s.avg_monthly_searches,\n      s.competition,\n      s.competition_index,\n      s.low_top_of_page_bid,\n      s.high_top_of_page_bid,\n      s.imported_at\n    from public.feya_commerce_seo_keyword_metric_import_staging_v1 s\n    where s.keyword_norm is not null\n      and (p_batch_code is null or s.batch_code = p_batch_code)\n    order by s.keyword_norm, s.imported_at desc nulls last, s.import_row_id desc\n  )\n  update public.feya_manual_keyword_candidate_v1 c\n  set avg_monthly_searches = m.avg_monthly_searches,\n      competition = m.competition,\n      competition_index = m.competition_index,\n      low_top_of_page_bid = m.low_top_of_page_bid,\n      high_top_of_page_bid = m.high_top_of_page_bid,\n      metric_geo = m.geo,\n      metric_language = m.language,\n      metric_batch_code = m.batch_code,\n      metric_imported_at = coalesce(m.imported_at, now()),\n      metrics_status = 'has_metric_import',\n      candidate_status = case when c.candidate_status = 'draft' then 'metric_imported' else c.candidate_status end,\n      updated_at = now()\n  from latest_metric m\n  where c.keyword_norm = m.keyword_norm;\n\n  get diagnostics v_updated = row_count;\n  return query select v_updated, v_matched, coalesce(p_batch_code, 'ALL_BATCHES');\nend;\n$function$\n",
      "anon_execute": false,
      "auth_execute": false,
      "security_definer": true
    },
    {
      "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
