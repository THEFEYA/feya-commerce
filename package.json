{
  "name": "feya-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:admin-boundary && npm run check:product-os-freeze && npm run check:owner-ui && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:seo": "node --experimental-strip-types --test tests/seo/*.test.ts",
    "check:admin-boundary": "node scripts/check-admin-data-boundary.mjs",
    "check:product-os-freeze": "node scripts/check-product-os-ui-freeze.mjs",
    "check:owner-ui": "node scripts/check-owner-ui-contract.mjs",
    "test:search": "node --experimental-strip-types --test tests/search/*.test.ts",
    "test:search-db": "node --test tests/search-db/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.117.1",
    "lucide-react": "^0.451.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.0"
  }
}
